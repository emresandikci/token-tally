{
  "name": "@emstack/token-tally",
  "version": "1.0.0",
  "private": false,
  "description": "Scan a project, count LLM tokens, and estimate cost using live pricing.",
  "type": "module",
  "bugs": {
    "url": "https://github.com/emresandikci/token-tally/issues"
  },
  "homepage": "https://github.com/emresandikci/token-tally#readme",
  "module": "./dist/cli.js",
  "bin": {
    "token-tally": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emresandikci/token-tally.git"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile=dist/cli.js --banner=\"#!/usr/bin/env node\" && chmod +x dist/cli.js",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "bun .husky/install.mjs",
    "lint": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,md,json}\"",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "commit": "SKIP_COMMIT_CHECK=true git-cz"
  },
  "keywords": [
    "llm",
    "tokens",
    "cost",
    "openai",
    "anthropic",
    "gemini",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@google/generative-ai": "^0.21.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "globby": "^14.0.2",
    "js-tiktoken": "^1.0.15",
    "ora": "^8.1.1",
    "p-limit": "^6.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "eslint": "^9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.4",
    "husky": "^9.0.11",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.3",
    "commitizen": "^4.3.1",
    "typescript": "^5.7.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
